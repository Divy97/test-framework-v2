{
  "name": "test-framework-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "images": "docker build -t test-framework-v2-sandbox:latest . && docker build -t test-framework-v2-agent:latest -f Dockerfile.agent .",
    "db:schema": "docker compose exec -T postgres psql -U postgres -d events -f - < db/schema.sql",
    "seed": "tsx --env-file=.env src/cli.ts seed",
    "replay": "tsx --env-file=.env src/cli.ts replay",
    "status": "tsx --env-file=.env src/status.ts",
    "serve": "tsx src/serve.ts",
    "rebuild": "tsx --env-file=.env src/cli.ts rebuild",
    "plane": "tsx src/plane-server.ts",
    "runner": "tsx src/runner-main.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@vercel/sandbox": "^3.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
