{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    // `test/screens.test.tsx` renders the dashboard's components. They need JSX, and
    // React's automatic runtime is what `web/tsconfig.json` compiles them under — two
    // settings that disagreed would mean the suite checked a file the bundle does not ship.
    "jsx": "react-jsx"
  },
  // `scripts` is in the program, and was not until 10n. It is a directory of operator
  // tools — pairing a worker, reconciling an installation, the live smoke run — that
  // nothing typechecked and nothing tests, so a rename in `src/` broke them silently and
  // the first person to find out was whoever ran one during an incident. Adding it found
  // two real errors immediately, both passing the `Intake` union where the issue half was
  // required, plus a syntax error in the file being written when this line was added.
  "include": ["src", "test", "scripts"],
  // `web/` is a SEPARATE PROGRAM with a separate tsconfig, and it has to be: its modules
  // are resolved by a bundler, so they import without a file extension, which `NodeNext`
  // above refuses by design. Typechecking them here would report an error in every import
  // in the front end.
  //
  // They are not unchecked. `next build` runs `tsc` over all of `web/` with
  // `moduleResolution: bundler` — the resolver those files are actually written for —
  // and fails the build on an error, which is how the split stays honest rather than
  // becoming a hole. `npm run web:build` is therefore part of the check, not just the ship.
  "exclude": ["test/screens.test.tsx"]
}
