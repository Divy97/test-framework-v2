# Copy to .env and set both variables to the same password.
# docker-compose reads POSTGRES_PASSWORD; the CLI reads DATABASE_URL.
# Dev database only — it holds synthetic events and is bound to 127.0.0.1.
#
#   cp .env.example .env
#   generate a password with: openssl rand -hex 16
#
# DATABASE_URL takes the form:
#   postgres://postgres:<password>@localhost:5432/events
POSTGRES_PASSWORD=
DATABASE_URL=

# Which model drives the agent (ADR-0015). Neither is needed for the test suite:
# every path is asserted against a scripted API, so `npx vitest run` needs no key.
#
# openrouter (default) — an OpenAI-shaped loop, and any of ~336 tool-capable models. Cheap
# reasoning models cost roughly a tenth of Opus on output, which is what makes
# iterating on a prompt affordable. A model that cannot make a structured tool call is
# refused by name before the run rather than producing an empty transcript after it.
#   OPENROUTER_API_KEY=sk-or-v1-…
#   ENGINE_MODEL=moonshotai/kimi-k2-thinking   # or deepseek/deepseek-r1, minimax/minimax-m2.5
#
# anthropic — the SDK's tool runner: native thinking, a maintained agentic loop, prompt
# caching. The better engine, for a run on a real repository that deserves it.
#   ENGINE_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-…
#
# ENGINE_EFFORT is the single biggest lever on spend: low|medium|high|xhigh|max.
# `high` is right for a real fix; `low` answers the only question prompt work asks.
#   ENGINE_EFFORT=low
